Systemd Quantum Services

```ini
# SAFEWAY GUARDIAN Systemd Services
# /etc/systemd/system/safeway-elemental.service

[Unit]
Description=SAFEWAY GUARDIAN Elemental Core Service
Documentation=https://safeway.fedoraproject.org
Wants=network-online.target
After=network-online.target podman-orbital.service
Before=trinity-ai.service eagle-eye.service

[Service]
Type=notify
ExecStartPre=/usr/bin/podman pull elemental-core:quantum
ExecStart=/usr/bin/podman run --name safeway-elemental \
    --security-opt label=type:safeway_elemental_t \
    --cap-add AI_QUANTUM \
    --cap-add ELEMENTAL_BALANCE \
    elemental-core:quantum
ExecStop=/usr/bin/podman stop -t 10 safeway-elemental
ExecStopPost=/usr/bin/podman rm -f safeway-elemental
Restart=always
RestartSec=30
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target default.target
```

